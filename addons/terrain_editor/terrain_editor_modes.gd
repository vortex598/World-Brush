@tool
extends PanelContainer

# Mode switcher for the terrain editor: a floating vertical icon strip overlaid
# on the 3D editor viewport (added by the plugin as a child of the editor
# viewport's GUI control, NOT the render SubViewport, so its buttons actually
# receive clicks). Icon-only buttons — the labels live in the tooltips. The
# plugin keeps the highlighted state in sync when a mode changes from anywhere.
#
# Visual language shared with the top toolbar:
#   - square corners, no hover/press highlight boxes
#   - the active mode shows a darker square box behind a blue icon

signal mode_changed(index: int)

const MODE_LABELS := [
	"WMT",
	"Zones",
	"Sculpt",
	"Paint",
	"Vertex",
	"Objects",
	"Settings",
]

const MODE_TOOLTIPS := [
	"add/remove terrain chunks and tiles",
	"Terrain Zones: biome/zone editing",
	"sculpt terrain",
	"paint terrain textures",
	"paint vertex colors onto terrain",
	"select and manipulate objects",
	"plugin settings, and generic settings",
]

const ICON_GRID := ""
const ICON_ZONES := ""
const ICON_SCULPT := ""
const ICON_SET_HEIGHT := ""
const ICON_PAINT := ""
const ICON_SETTINGS := ""

const ICON_OBJECTS := ""

const ICON_VERTEX := ""

const MODE_ICONS := [ICON_GRID, ICON_ZONES, ICON_SCULPT, ICON_PAINT, ICON_VERTEX, ICON_OBJECTS, ICON_SETTINGS]

const ICON_ACTIVE := Color(0.35, 0.6, 1.0)
const ICON_IDLE := Color(0.82, 0.84, 0.88)
const BACKING_COLOR := Color(0.0, 0.0, 0.0, 0.4)
const SIZE_SCALE := 1.2

var buttons: Array[Button] = []

func _ready() -> void:
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0.10, 0.11, 0.14, 0.9)
	sb.set_border_width_all(1)
	sb.border_color = Color(0.34, 0.36, 0.42, 0.9)
	sb.set_corner_radius_all(0)
	sb.set_content_margin_all(int(round(4 * SIZE_SCALE)))
	add_theme_stylebox_override("panel", sb)
	# PASS (not IGNORE): the strip's background counts as "over the float" so
	# the plugin never starts a stroke under it, while still letting the click
	# fall through to controls underneath.
	mouse_filter = Control.MOUSE_FILTER_PASS
	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", int(round(2 * SIZE_SCALE)))
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(col)
	_build(col)

func _build(col: VBoxContainer) -> void:
	for child in col.get_children():
		child.queue_free()
	buttons.clear()
	for i in MODE_LABELS.size():
		var b := Button.new()
		b.icon = _png_texture(MODE_ICONS[i])
		b.tooltip_text = "%s\n%s" % [MODE_LABELS[i], MODE_TOOLTIPS[i]]
		b.focus_mode = Control.FOCUS_NONE
		b.add_theme_constant_override("icon_max_width", int(round(18 * SIZE_SCALE)))
		b.custom_minimum_size = Vector2(int(round(34 * SIZE_SCALE)), int(round(34 * SIZE_SCALE)))
		b.expand_icon = true
		b.mouse_filter = Control.MOUSE_FILTER_STOP
		b.pressed.connect(_on_mode_button.bind(i))
		_refresh(b, false)
		buttons.append(b)
		col.add_child(b)

func _png_texture(b64: String) -> Texture2D:
	var img := Image.new()
	img.load_png_from_buffer(Marshalls.base64_to_raw(b64))
	return ImageTexture.create_from_image(img)

func _on_mode_button(index: int) -> void:
	mode_changed.emit(index)

func set_active(index: int) -> void:
	for i in buttons.size():
		_refresh(buttons[i], i == index)

func _refresh(b: Button, on: bool) -> void:
	b.add_theme_stylebox_override("normal", _button_style(on))
	b.add_theme_stylebox_override("hover", _button_style(on))
	b.add_theme_stylebox_override("pressed", _button_style(on))
	b.add_theme_stylebox_override("focus", _button_style(on))
	b.add_theme_stylebox_override("disabled", _button_style(on))
	var c := ICON_ACTIVE if on else ICON_IDLE
	b.add_theme_color_override("icon_normal_color", c)
	b.add_theme_color_override("icon_hover_color", c)
	b.add_theme_color_override("icon_pressed_color", c)
	b.add_theme_color_override("icon_focus_color", c)

func _button_style(on: bool) -> StyleBoxFlat:
	var sbx := StyleBoxFlat.new()
	sbx.bg_color = BACKING_COLOR if on else Color(0.0, 0.0, 0.0, 0.0)
	sbx.set_corner_radius_all(0)
	sbx.set_content_margin_all(int(round(2 * SIZE_SCALE)))
	return sbx
