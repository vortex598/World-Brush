@tool
extends PanelContainer

# Floating horizontal toolbar at the top of the 3D editor viewport (added by
# the plugin as a child of the editor viewport's GUI control, NOT the render
# SubViewport, so its buttons actually receive clicks). Icon-only buttons:
# Load / Save actions, then four toggles — wireframe grid, colored
# tile/chunk lattice lines (merged into one button), the scene's directional
# light ("WMT Sun"), and the vertex-colors overlay.
#
# Visual language shared with the mode sidebar:
#   - square corners, no hover/press highlight boxes
#   - an enabled toggle shows a darker square box behind it and a blue icon

signal load_pressed
signal save_pressed
signal wireframe_toggled(on: bool)
signal grid_toggled(on: bool)
signal shading_toggled(on: bool)
signal vertex_toggled(on: bool)

const ICON_LOAD := '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="#ffffff" stroke-width="2" stroke-linejoin="round"><path d="M12 4 V16"/><path d="M6 10 L12 16 L18 10"/><path d="M4 20 H20"/></g></svg>'
const ICON_SAVE := '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="#ffffff" stroke-width="2" stroke-linejoin="round"><path d="M4 4 H16 L20 8 V20 H4 Z"/><path d="M8 4 V10 H15 V4"/><path d="M8 20 V14 H16 V20"/></g></svg>'
# Box outline + vertical midline + horizontal midline + X across the corners.
const ICON_WIRE := ""
# Square outline divided into 9 squares (3x3 tile lattice).
const ICON_GRID := ""
const ICON_SHADE := ""
const ICON_VERTCOL := ""

const ICON_ACTIVE := Color(0.35, 0.6, 1.0)
const ICON_IDLE := Color(0.82, 0.84, 0.88)
const BACKING_COLOR := Color(0.0, 0.0, 0.0, 0.4)
const SIZE_SCALE := 1.2

var load_button: Button
var save_button: Button
var wire_button: Button
var grid_button: Button
var shading_button: Button
var vertex_button: Button

func _ready() -> void:
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0.10, 0.11, 0.14, 0.9)
	sb.set_border_width_all(1)
	sb.border_color = Color(0.34, 0.36, 0.42, 0.9)
	sb.set_corner_radius_all(0)
	sb.set_content_margin_all(posi(4 * SIZE_SCALE) as int)
	add_theme_stylebox_override("panel", sb)
	# PASS (not IGNORE): the bar's background counts as "over the float" so the
	# plugin never starts a stroke under it, while still letting the click
	# fall through to controls underneath.
	mouse_filter = Control.MOUSE_FILTER_PASS
	var col := HBoxContainer.new()
	col.add_theme_constant_override("separation", posi(2 * SIZE_SCALE) as int)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(col)

	load_button = _make_action(col, ICON_LOAD, "Load a .wmt terrain file", func(): load_pressed.emit())
	save_button = _make_action(col, ICON_SAVE, "Save the terrain to disk", func(): save_pressed.emit())
	col.add_child(_sep())
	wire_button = _make_toggle(col, ICON_WIRE, "Wireframe: white/black cell grid", wireframe_toggled)
	grid_button = _make_toggle(col, ICON_GRID, "Tile + chunk lattice lines", grid_toggled)
	shading_button = _make_toggle(col, ICON_SHADE, "Directional light (WMT Sun) on/off", shading_toggled)
	vertex_button = _make_toggle(col, ICON_VERTCOL, "Vertex colors overlay (multiply tints)", vertex_toggled)
	_sync_toggles()

func posi(v: float) -> int:
	return int(round(v))

func _sep() -> Control:
	var s := Control.new()
	s.custom_minimum_size = Vector2(posi(6 * SIZE_SCALE), 0)
	s.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return s

func _make_action(parent: Control, svg: String, tip: String, cb: Callable) -> Button:
	var b := _base_button(svg, tip)
	b.pressed.connect(cb)
	parent.add_child(b)
	return b

func _make_toggle(parent: Control, svg: String, tip: String, sig: Signal) -> Button:
	var b := _base_button(svg, tip)
	b.toggle_mode = true
	b.toggled.connect(func(on: bool):
		_sync_toggles()
		sig.emit(on))
	parent.add_child(b)
	return b

func _base_button(data: String, tip: String) -> Button:
	var b := Button.new()
	b.icon = _icon_texture(data)
	b.tooltip_text = tip
	b.focus_mode = Control.FOCUS_NONE
	b.add_theme_constant_override("icon_max_width", posi(16 * SIZE_SCALE))
	b.custom_minimum_size = Vector2(posi(30 * SIZE_SCALE), posi(30 * SIZE_SCALE))
	b.expand_icon = true
	b.mouse_filter = Control.MOUSE_FILTER_STOP
	_refresh_button(b)
	return b

func _icon_texture(data: String) -> Texture2D:
	if data.begins_with("<svg"):
		return _svg_texture(data)
	return _png_texture(data)

func _png_texture(b64: String) -> Texture2D:
	var img := Image.new()
	img.load_png_from_buffer(Marshalls.base64_to_raw(b64))
	return ImageTexture.create_from_image(img)

func _svg_texture(svg: String) -> Texture2D:
	var img := Image.new()
	img.load_svg_from_buffer(svg.to_utf8_buffer(), 2.0)
	return ImageTexture.create_from_image(img)

func set_states(wire: bool, grid: bool, shading: bool, vertex: bool) -> void:
	wire_button.set_pressed_no_signal(wire)
	grid_button.set_pressed_no_signal(grid)
	shading_button.set_pressed_no_signal(shading)
	vertex_button.set_pressed_no_signal(vertex)
	_sync_toggles()

# Drives the active visuals (blue icon + dark backing square) from the pressed
# state of the toggle buttons.
func _sync_toggles() -> void:
	_refresh_button(wire_button)
	_refresh_button(grid_button)
	_refresh_button(shading_button)
	_refresh_button(vertex_button)

func _refresh_button(b: Button) -> void:
	var on := b.button_pressed
	b.add_theme_stylebox_override("normal", _button_style(on))
	b.add_theme_stylebox_override("hover", _button_style(on))
	b.add_theme_stylebox_override("pressed", _button_style(on))
	b.add_theme_stylebox_override("focus", _button_style(on))
	b.add_theme_stylebox_override("disabled", _button_style(on))
	var c := ICON_ACTIVE if on else ICON_IDLE
	b.add_theme_color_override("icon_normal_color", c)
	b.add_theme_color_override("icon_hover_color", c)
	b.add_theme_color_override("icon_pressed_color", c)
	b.add_theme_color_override("icon_focus_color", c)

func _button_style(on: bool) -> StyleBoxFlat:
	var sbx := StyleBoxFlat.new()
	sbx.bg_color = BACKING_COLOR if on else Color(0.0, 0.0, 0.0, 0.0)
	sbx.set_corner_radius_all(0)
	sbx.set_content_margin_all(posi(4 * SIZE_SCALE * 0.5) as int)
	return sbx